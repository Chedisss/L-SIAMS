#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * L-SIAMS command line console.
 *
 *   php bin/console key:generate         Generate APP_KEY / API_KEY_PEPPER / ticket secret
 *   php bin/console migrate              Apply pending migrations
 *   php bin/console migrate:status       Show which migrations have run
 *   php bin/console migrate:fresh        Drop everything and re-migrate (destructive)
 *   php bin/console seed [--demo]        Seed reference data (and optional demo data)
 *   php bin/console install              key:generate + migrate + seed, in one step
 *   php bin/console worker               Maintenance worker (sessions, heartbeats, auto-close)
 *   php bin/console backup               Create an encrypted backup now
 *   php bin/console security:audit-keys  Static check that no weak RNG is in the key path
 *   php bin/console doctor               Diagnose a running installation
 *   php bin/console db:import <file>     Import a .sql file or phpMyAdmin export
 *   php bin/console time:shift "+2 hours" Move the clock for schedule testing
 *   php bin/console user:create-admin    Create an administrator interactively
 */

if (PHP_SAPI !== 'cli') {
    fwrite(STDERR, "This script must be run from the command line.\n");
    exit(1);
}

/** @var App\Core\App $app */
$app = require dirname(__DIR__) . '/bootstrap.php';

use App\Core\Clock;
use App\Core\Config;
use App\Core\Crypto;
use App\Core\Database;
use App\Core\Env;
use App\Core\Hash;
use App\Services\ApiKeyService;
use App\Services\AttendanceSessionService;
use App\Services\BackupService;
use App\Services\DeviceService;
use App\Services\IdempotencyService;
use App\Services\NotificationService;
use App\Services\RealtimeService;
use App\Services\SessionService;

$command   = $argv[1] ?? 'help';
$arguments = array_slice($argv, 2);
$flags     = array_values(array_filter($arguments, static fn (string $a): bool => str_starts_with($a, '--')));

function out(string $message = '', string $colour = ''): void
{
    $colours = [
        'red' => "\033[31m", 'green' => "\033[32m", 'yellow' => "\033[33m",
        'blue' => "\033[34m", 'cyan' => "\033[36m", 'grey' => "\033[90m", 'bold' => "\033[1m",
    ];

    $prefix = $colours[$colour] ?? '';
    $suffix = $prefix === '' ? '' : "\033[0m";

    fwrite(STDOUT, $prefix . $message . $suffix . PHP_EOL);
}

function fail(string $message): never
{
    out('✗ ' . $message, 'red');
    exit(1);
}

function ok(string $message): void
{
    out('✓ ' . $message, 'green');
}

function heading(string $message): void
{
    out('');
    out($message, 'bold');
    out(str_repeat('─', min(70, strlen($message))), 'grey');
}

function prompt(string $question, bool $hidden = false): string
{
    fwrite(STDOUT, $question . ': ');

    if ($hidden && DIRECTORY_SEPARATOR !== '\\') {
        @shell_exec('stty -echo 2>/dev/null');
        $value = trim((string) fgets(STDIN));
        @shell_exec('stty echo 2>/dev/null');
        fwrite(STDOUT, PHP_EOL);

        return $value;
    }

    return trim((string) fgets(STDIN));
}

// ---------------------------------------------------------------------------

try {
    match ($command) {
        'key:generate'        => commandKeyGenerate($flags),
        'migrate'             => commandMigrate(),
        'migrate:status'      => commandMigrateStatus(),
        'migrate:fresh'       => commandMigrateFresh($flags),
        'seed'                => commandSeed($flags),
        'install'             => commandInstall($flags),
        'worker'              => commandWorker($arguments),
        'backup'              => commandBackup(),
        'security:audit-keys' => commandAuditKeys(),
        'doctor'              => commandDoctor(),
        'db:import'           => commandDbImport($arguments, $flags),
        'backup:decrypt'      => commandBackupDecrypt($arguments),
        'time:shift'          => commandTimeShift($arguments, $flags),
        'schema:dump'         => commandSchemaDump(),
        'user:create-admin'   => commandCreateAdmin(),
        'user:purge'          => commandUserPurge($arguments, $flags),
        'session:why'         => commandSessionWhy($arguments),
        default               => commandHelp(),
    };
} catch (Throwable $e) {
    out('');
    fail($e->getMessage() . "\n  at " . $e->getFile() . ':' . $e->getLine());
}

// ---------------------------------------------------------------------------

function commandHelp(): void
{
    out('');
    out('  L-SIAMS console', 'bold');
    out('  Local IoT-Based Multi-Layer Secured Attendance Monitoring System', 'grey');
    out('');
    out('  Setup', 'cyan');
    out('    install                 Generate keys, migrate and seed in one step');
    out('    key:generate            Generate cryptographic keys into .env');
    out('    migrate                 Apply pending migrations');
    out('    migrate:status          Show migration state');
    out('    migrate:fresh --force   Drop all tables and re-migrate (destructive)');
    out('    seed [--demo]           Seed reference data, optionally with demo records');
    out('    user:create-admin       Create an administrator account interactively');
    out('    user:purge <id>         Erase a user and their history (destructive, last resort)');
    out('');
    out('  Operations', 'cyan');
    out('    worker [--once]         Maintenance loop: sessions, heartbeats, retention');
    out('    backup                  Create an encrypted database backup');
    out('    security:audit-keys     Verify no weak RNG exists in the key path');
    out('    doctor                  Diagnose this installation and report problems');
    out('    session:why [device]    Explain why a terminal will not open a session now');
    out('    schema:dump             Write database/lsiams_schema.sql for phpMyAdmin import');
    out('    db:import <file.sql>    Import a .sql file or phpMyAdmin export (--fresh drops first)');
    out('    backup:decrypt <file>   Turn a backup archive back into readable SQL');
    out('    time:shift ["+2 hours"]  Move the clock to test a schedule (--clear to undo)');
    out('');
}

/**
 * Generate the three secrets the application needs, writing them into .env.
 * Existing values are never overwritten without --force: doing so would make
 * every stored HMAC secret and every live session permanently unreadable.
 */
function commandKeyGenerate(array $flags): void
{
    heading('Generating cryptographic keys');

    $envFile = BASE_PATH . '/.env';

    if (!is_file($envFile)) {
        if (!is_file(BASE_PATH . '/.env.example')) {
            fail('Neither .env nor .env.example exists.');
        }

        copy(BASE_PATH . '/.env.example', $envFile);
        @chmod($envFile, 0600);
        ok('Created .env from .env.example');
    }

    $contents = (string) file_get_contents($envFile);
    $force    = in_array('--force', $flags, true);
    $written  = 0;

    // Is there already encrypted data that a new APP_KEY would orphan?
    //
    // The guarded case is obvious and handled below: a key that is present is
    // skipped unless --force. The unguarded one is the dangerous one, because
    // it does not look like a key change at all — .env goes missing, or is
    // moved aside, and start.bat recreates it and calls this command. Every
    // value is then "absent", so fresh keys are generated with no warning and
    // the message on screen reads "First run - setting up".
    //
    // It is not a first run. The database is still full, and every terminal
    // secret and fingerprint template in it has just become unreadable —
    // permanently, because the key that opened them is the file that went
    // missing. That is the single most destructive thing this project can do
    // to itself, and until now it did it quietly.
    //
    // The database may legitimately not exist yet on a real first run, so a
    // failure to look is not an error: it means there is nothing to lose.
    $existingSecrets = 0;

    try {
        $probe = Database::instance();
        $existingSecrets = (int) $probe->scalar(
            "SELECT COUNT(*) FROM api_keys
              WHERE hmac_secret_encrypted IS NOT NULL AND status = 'active'"
        );

        if ($probe->hasColumn('fingerprint_templates', 'template_data')) {
            $existingSecrets += (int) $probe->scalar(
                'SELECT COUNT(*) FROM fingerprint_templates WHERE template_data IS NOT NULL'
            );
        }
    } catch (Throwable $e) {
        $existingSecrets = 0;      // no reachable database, so nothing at risk
    }

    $appKeySet = preg_match('/^APP_KEY=(.+)$/m', $contents, $m) === 1 && trim($m[1]) !== '';
    $withheld  = $existingSecrets > 0 && !$appKeySet && !$force;

    // The refusal below is right, but it used to fail() before writing
    // anything — so an installation that hit it was left with NO keys rather
    // than one missing key, and doctor reported all three unset. Only two of
    // them can orphan data:
    //
    //   APP_KEY         opens terminal secrets and fingerprint templates
    //   API_KEY_PEPPER  hashes API keys; a new one invalidates every device key
    //
    // REALTIME_TICKET_SECRET signs short-lived realtime tickets and nothing
    // stored depends on it, so withholding it protected nothing and only made
    // the installation look more broken than it was. It is written either way.
    $atRisk = ['APP_KEY', 'API_KEY_PEPPER'];

    if ($withheld) {
        out('');
        out('  ✗ Refusing to generate a new APP_KEY.', 'red');
        out('');
        out(sprintf('  This database already holds %d encrypted value(s) — terminal secrets', $existingSecrets), 'yellow');
        out('  and fingerprint templates — and .env has no APP_KEY to read them with.', 'yellow');
        out('');
        out('  Generating one now would not recover them. It would replace the key they', 'grey');
        out('  were encrypted with, permanently, and every terminal would stop', 'grey');
        out('  authenticating while every enrolled fingerprint stopped matching.', 'grey');
        out('');
        out('  The original .env is what opens this data. Look for it before doing', 'grey');
        out('  anything else — a backup, the machine this database came from, or a', 'grey');
        out('  copy taken before the move. See docs/MOVING-TO-ANOTHER-PC.md', 'grey');
        out('');
        out('  If it is genuinely gone, --force generates a new key and accepts the', 'grey');
        out('  loss: re-issue every terminal\'s provisioning file and enrol every', 'grey');
        out('  fingerprint again. Nothing else in the database is affected.', 'grey');
        out('');
        out('  APP_KEY and API_KEY_PEPPER are being withheld. REALTIME_TICKET_SECRET', 'grey');
        out('  is written below — nothing stored depends on it, so it carries no risk.', 'grey');
        out('');
    }

    foreach (['APP_KEY', 'API_KEY_PEPPER', 'REALTIME_TICKET_SECRET'] as $name) {
        if ($withheld && in_array($name, $atRisk, true)) {
            out('  ' . $name . ' withheld — see above (use --force only if the original .env is gone)', 'yellow');
            continue;
        }

        $hasValue = preg_match('/^' . $name . '=(.+)$/m', $contents, $matches) === 1
            && trim($matches[1]) !== '';

        if ($hasValue && !$force) {
            out('  ' . $name . ' already set — skipping (use --force to replace)', 'grey');
            continue;
        }

        if ($hasValue && $force) {
            out('  ⚠ Replacing ' . $name . ' — encrypted HMAC secrets and live sessions will be invalidated.', 'yellow');
        }

        $value = base64_encode(Crypto::randomBytes(32));

        $contents = preg_match('/^' . $name . '=.*$/m', $contents) === 1
            ? (string) preg_replace('/^' . $name . '=.*$/m', $name . '=' . $value, $contents)
            : $contents . PHP_EOL . $name . '=' . $value;

        ok($name . ' generated (256-bit CSPRNG)');
        $written++;
    }

    file_put_contents($envFile, $contents);
    @chmod($envFile, 0600);

    if ($written > 0) {
        out('');
        out('  .env permissions set to 0600. Keep this file out of version control.', 'grey');
    }

    // Non-zero, so start.bat and update.bat stop rather than launching a
    // system that cannot encrypt anything. The two withheld keys are the whole
    // point: this is not a partial success to be shrugged off.
    if ($withheld) {
        out('');
        fail('APP_KEY generation refused — run with --force only if the original .env is gone.');
    }
}

/** @return list<array{name:string,path:string,checksum:string}> */
function discoverMigrations(): array
{
    $directory = (string) Config::get('app.paths.migrations');
    $files     = glob($directory . '/*.sql') ?: [];

    sort($files, SORT_NATURAL);

    return array_map(static fn (string $path): array => [
        'name'     => basename($path),
        'path'     => $path,
        'checksum' => hash_file('sha256', $path),
    ], $files);
}

function ensureMigrationsTable(Database $db): void
{
    $db->pdo()->exec(
        'CREATE TABLE IF NOT EXISTS schema_migrations (
            migration  VARCHAR(190) NOT NULL PRIMARY KEY,
            batch      INT UNSIGNED NOT NULL,
            checksum   CHAR(64)     NOT NULL,
            applied_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4'
    );
}

function commandMigrate(): void
{
    heading('Running migrations');

    $db = Database::instance();
    ensureMigrationsTable($db);

    $applied = [];

    foreach ($db->select('SELECT migration, checksum FROM schema_migrations') as $row) {
        $applied[(string) $row['migration']] = (string) $row['checksum'];
    }

    $batch   = (int) $db->scalar('SELECT COALESCE(MAX(batch), 0) + 1 FROM schema_migrations');
    $pending = 0;

    foreach (discoverMigrations() as $migration) {
        if (isset($applied[$migration['name']])) {
            // A changed checksum means someone edited an applied migration —
            // dangerous, because the database no longer matches the file.
            if ($applied[$migration['name']] !== $migration['checksum']) {
                out('  ⚠ ' . $migration['name'] . ' has changed since it was applied.', 'yellow');
            }
            continue;
        }

        out('  → ' . $migration['name'], 'cyan');

        $sql = (string) file_get_contents($migration['path']);

        try {
            runSqlScript($db, $sql);
        } catch (Throwable $e) {
            fail($migration['name'] . ' failed: ' . $e->getMessage());
        }

        $db->insert('schema_migrations', [
            'migration' => $migration['name'],
            'batch'     => $batch,
            'checksum'  => $migration['checksum'],
        ]);

        ok('  ' . $migration['name']);
        $pending++;
    }

    out('');
    $pending === 0 ? ok('Database is already up to date.') : ok($pending . ' migration(s) applied.');
}

/**
 * Execute a .sql file, honouring DELIMITER blocks so triggers and procedures
 * containing internal semicolons are not split apart.
 */
function runSqlScript(Database $db, string $sql): void
{
    foreach (splitSqlStatements($sql) as $statement) {
        $db->pdo()->exec($statement);
    }
}

/**
 * Break a .sql file into individual statements, honouring DELIMITER blocks so
 * triggers and procedures containing internal semicolons stay in one piece.
 *
 * @return list<string>
 */
function splitSqlStatements(string $sql): array
{
    $delimiter  = ';';
    $buffer     = '';
    $statements = [];

    foreach (preg_split('/\r\n|\n|\r/', $sql) ?: [] as $line) {
        $trimmed = trim($line);

        if ($trimmed === '' || str_starts_with($trimmed, '--')) {
            continue;
        }

        if (stripos($trimmed, 'DELIMITER ') === 0) {
            if (trim($buffer) !== '') {
                $statements[] = $buffer;
                $buffer       = '';
            }

            $delimiter = trim(substr($trimmed, 10));
            continue;
        }

        $buffer .= $line . "\n";

        if (str_ends_with($trimmed, $delimiter)) {
            $statement = substr(rtrim($buffer), 0, -strlen($delimiter));

            if (trim($statement) !== '') {
                $statements[] = $statement;
            }

            $buffer = '';
        }
    }

    if (trim($buffer) !== '') {
        $statements[] = $buffer;
    }

    return array_values(array_filter(
        $statements,
        static fn (string $statement): bool => trim($statement) !== ''
    ));
}

function commandMigrateStatus(): void
{
    heading('Migration status');

    $db = Database::instance();
    ensureMigrationsTable($db);

    $applied = [];

    foreach ($db->select('SELECT migration, batch, applied_at FROM schema_migrations') as $row) {
        $applied[(string) $row['migration']] = $row;
    }

    foreach (discoverMigrations() as $migration) {
        if (isset($applied[$migration['name']])) {
            out(sprintf('  %-52s applied  %s', $migration['name'], $applied[$migration['name']]['applied_at']), 'green');
        } else {
            out(sprintf('  %-52s pending', $migration['name']), 'yellow');
        }
    }
}

function commandMigrateFresh(array $flags): void
{
    if (!in_array('--force', $flags, true)) {
        fail('migrate:fresh destroys all data. Re-run with --force to confirm.');
    }

    heading('Dropping all tables');

    $db = Database::instance();
    $db->pdo()->exec('SET FOREIGN_KEY_CHECKS = 0');

    foreach ($db->select('SHOW FULL TABLES WHERE Table_type = "VIEW"') as $row) {
        $name = (string) array_values($row)[0];
        $db->pdo()->exec(sprintf('DROP VIEW IF EXISTS `%s`', $name));
    }

    foreach ($db->select('SHOW FULL TABLES WHERE Table_type = "BASE TABLE"') as $row) {
        $name = (string) array_values($row)[0];
        $db->pdo()->exec(sprintf('DROP TABLE IF EXISTS `%s`', $name));
        out('  dropped ' . $name, 'grey');
    }

    $db->pdo()->exec('SET FOREIGN_KEY_CHECKS = 1');
    ok('Schema dropped.');

    commandMigrate();
}

function commandSeed(array $flags): void
{
    heading('Seeding');

    $seeders = [
        BASE_PATH . '/database/seeders/ReferenceSeeder.php',
    ];

    if (in_array('--demo', $flags, true)) {
        $seeders[] = BASE_PATH . '/database/seeders/DemoSeeder.php';
    }

    foreach ($seeders as $file) {
        if (!is_file($file)) {
            out('  skipped (missing) ' . basename($file), 'grey');
            continue;
        }

        out('  → ' . basename($file), 'cyan');
        $result = require $file;

        if (is_callable($result)) {
            $result(Database::instance());
        }
    }

    ok('Seeding complete.');
}

function commandInstall(array $flags): void
{
    out('');
    out('  L-SIAMS installation', 'bold');
    out('');

    commandKeyGenerate($flags);

    // Config is read once at boot, so the freshly written keys need re-reading
    // before anything tries to encrypt with them.
    App\Core\Env::load(BASE_PATH . '/.env');

    commandMigrate();
    commandSeed($flags);

    heading('Next steps');
    out('  1. Create an administrator:   php bin/console user:create-admin');
    out('  2. Start the realtime server: php realtime/server.php');
    out('  3. Schedule the worker:       php bin/console worker');
    out('  4. Sign in and register your classrooms, sections and terminals.');
    out('');
}

/**
 * Maintenance worker.
 *
 * Everything time-driven in the system lives here: sessions that must close,
 * devices that stopped talking, and the retention sweeps. Run it from cron
 * (every minute) or as a long-lived service.
 */
function commandWorker(array $arguments): void
{
    $once     = in_array('--once', $arguments, true);
    $interval = 60;

    foreach ($arguments as $argument) {
        if (str_starts_with($argument, '--interval=')) {
            $interval = max(10, (int) substr($argument, 11));
        }
    }

    out('');
    out('  L-SIAMS maintenance worker' . ($once ? ' (single pass)' : ' (every ' . $interval . 's)'), 'bold');
    out('  Press Ctrl+C to stop.', 'grey');
    out('');

    $tick = 0;

    do {
        $tick++;
        $started = microtime(true);

        try {
            $closed = AttendanceSessionService::autoCloseExpired();
            if ($closed > 0) {
                out(sprintf('[%s] closed %d expired session(s)', date('H:i:s'), $closed), 'cyan');
            }

            $expiring = AttendanceSessionService::notifyExpiringSessions(5);
            if ($expiring > 0) {
                out(sprintf('[%s] warned %d session(s) about closing soon', date('H:i:s'), $expiring), 'grey');
            }

            $offline = DeviceService::markStaleDevicesOffline();
            if ($offline > 0) {
                out(sprintf('[%s] marked %d device(s) offline', date('H:i:s'), $offline), 'yellow');
            }

            $sessions = SessionService::expireStaleSessions();
            if ($sessions > 0) {
                out(sprintf('[%s] expired %d web session(s)', date('H:i:s'), $sessions), 'grey');
            }

            $graced = ApiKeyService::expireGracePeriods();
            if ($graced > 0) {
                out(sprintf('[%s] auto-revoked %d rotated key(s)', date('H:i:s'), $graced), 'yellow');
            }

            // Retention sweeps run hourly rather than every tick.
            if ($tick % 60 === 1) {
                $retention = (array) Config::get('attendance.retention', []);

                $purged = [
                    'heartbeats'   => DeviceService::purgeOldHeartbeats((int) ($retention['heartbeats_days'] ?? 90)),
                    'notifications' => NotificationService::purgeOld((int) ($retention['notifications_days'] ?? 180)),
                    'events'       => RealtimeService::purgeOldEvents((int) ($retention['realtime_events_hours'] ?? 48)),
                    'requests'     => IdempotencyService::purgeOld((int) ($retention['processed_requests_hours'] ?? 24)),
                    'tickets'      => RealtimeService::purgeExpiredTickets(),
                    'nonces'       => Database::instance()->execute(
                        'DELETE FROM device_nonces WHERE used_at < DATE_SUB(NOW(), INTERVAL :hours HOUR)',
                        ['hours' => (int) ($retention['nonces_hours'] ?? 24)]
                    ),
                ];

                $total = array_sum($purged);

                if ($total > 0) {
                    out(sprintf('[%s] retention sweep removed %d row(s): %s',
                        date('H:i:s'), $total,
                        implode(', ', array_map(
                            static fn (string $k, int $v): string => $k . '=' . $v,
                            array_keys($purged), array_values($purged)
                        ))
                    ), 'grey');
                }
            }
        } catch (Throwable $e) {
            out(sprintf('[%s] worker error: %s', date('H:i:s'), $e->getMessage()), 'red');
            App\Core\Logger::exception($e);
        }

        if ($once) {
            break;
        }

        $elapsed = microtime(true) - $started;
        $sleep   = max(1, $interval - (int) $elapsed);
        sleep($sleep);
    } while (true);

    ok('Worker finished.');
}

function commandBackup(): void
{
    heading('Creating backup');

    $result = BackupService::create('manual', null);

    ok(sprintf('%s — %d tables, %s',
        $result['filename'], $result['tables'], BackupService::humanSize($result['size'])));
    out('  SHA-256: ' . $result['checksum'], 'grey');
    out('  Duration: ' . $result['duration'] . 's', 'grey');

    // The half of a backup that is easy to leave behind.
    //
    // The file is encrypted with this installation's APP_KEY, so it can only
    // be read back by an installation holding that same key. Copy the database
    // to another PC, run key:generate there, and the backup you carefully took
    // is permanently unreadable — along with every fingerprint template and
    // every terminal's HMAC secret, which are encrypted with it too.
    //
    // Nothing said so until somebody needed the backup, which is the worst
    // possible moment to find out.
    out('');
    out('  Keep .env with this file.', 'yellow');
    out('  It is encrypted with this installation\'s APP_KEY and cannot be read', 'grey');
    out('  back without it — not by this project, not by anyone. The same key', 'grey');
    out('  also decrypts the fingerprint templates and the terminals\' HMAC', 'grey');
    out('  secrets, so a database restored beside a NEW key loses all three.', 'grey');
    out('  Moving to another PC? See docs/MOVING-TO-ANOTHER-PC.md', 'grey');
}

/**
 * Diagnose a running installation.
 *
 * Written for the situation where a page "does not work" and nobody can see
 * why: it reports what the system actually contains and which of its moving
 * parts are running, rather than asking anyone to read a log. Every check is
 * read-only, so it is safe to run against a live school installation.
 */
function commandDoctor(): void
{
    $problems = [];
    $warnings = [];

    $note = static function (string $message): void { out('    ' . $message, 'grey'); };

    $check = static function (bool $healthy, string $label, string $detail = '') use (&$problems): void {
        out(sprintf('  %s %-42s %s', $healthy ? '✓' : '✗', $label, $detail), $healthy ? 'green' : 'red');

        if (!$healthy) {
            $problems[] = $label . ($detail === '' ? '' : ' — ' . $detail);
        }
    };

    $warn = static function (string $label, string $detail = '') use (&$warnings): void {
        out(sprintf('  ! %-42s %s', $label, $detail), 'yellow');
        $warnings[] = $label . ($detail === '' ? '' : ' — ' . $detail);
    };

    // ------------------------------------------------------------ runtime --
    heading('Runtime');

    $check(PHP_VERSION_ID >= 80100, 'PHP 8.1 or newer', PHP_VERSION);

    foreach (['pdo_mysql', 'openssl', 'mbstring', 'json'] as $extension) {
        $check(extension_loaded($extension), 'Extension ' . $extension, extension_loaded($extension) ? '' : 'not loaded');
    }

    foreach (['zip' => 'Excel export and device bundles', 'gd' => 'profile photo uploads'] as $extension => $used) {
        if (!extension_loaded($extension)) {
            $warn('Extension ' . $extension . ' off', 'only affects ' . $used);
        }
    }

    // ------------------------------------------------------ configuration --
    heading('Configuration');

    $check(is_file(BASE_PATH . '/.env'), '.env exists');

    foreach (['APP_KEY', 'API_KEY_PEPPER', 'REALTIME_TICKET_SECRET'] as $key) {
        $value = (string) Env::get($key, '');
        $check($value !== '', $key, $value === '' ? 'not set — run key:generate' : 'set');
    }

    $appUrl = (string) Env::get('APP_URL', '');
    if ($appUrl === '') {
        $note('APP_URL is blank; the base URL is derived from the request host. That is fine on a LAN.');
    } else {
        $note('APP_URL is ' . $appUrl);
    }

    // --------------------------------------------------------------- data --
    heading('Database');

    try {
        $db = Database::instance();
        $db->scalar('SELECT 1');
        ok('Connected to ' . Config::get('database.database', '?') . ' on '
            . Config::get('database.host', '?') . ':' . Config::get('database.port', '?'));
    } catch (Throwable $e) {
        $check(false, 'Database connection', $e->getMessage());
        doctorSummary($problems, $warnings);

        return;
    }

    ensureMigrationsTable($db);

    $applied = array_column($db->select('SELECT migration FROM schema_migrations'), 'migration');
    $pending = array_values(array_filter(
        array_column(discoverMigrations(), 'name'),
        static fn (string $name): bool => !in_array($name, $applied, true)
    ));

    $check($pending === [], 'All migrations applied', $pending === [] ? count($applied) . ' applied' : implode(', ', $pending));

    $counts = [
        'departments'  => "SELECT COUNT(*) FROM departments WHERE deleted_at IS NULL",
        'teachers'     => "SELECT COUNT(*) FROM teachers WHERE deleted_at IS NULL AND status = 'active'",
        'students'     => "SELECT COUNT(*) FROM students WHERE deleted_at IS NULL AND status = 'active'",
        'sections'     => "SELECT COUNT(*) FROM sections WHERE deleted_at IS NULL",
        'schedules'    => "SELECT COUNT(*) FROM schedules WHERE deleted_at IS NULL AND status = 'active'",
        'devices'      => "SELECT COUNT(*) FROM devices WHERE deleted_at IS NULL",
        'user accounts' => "SELECT COUNT(*) FROM users WHERE deleted_at IS NULL",
    ];

    heading('What this system contains');

    foreach ($counts as $label => $sql) {
        out(sprintf('  %-16s %d', $label, (int) $db->scalar($sql)), 'grey');
    }

    // -------------------------------------------------------- fingerprints --
    // ---------------------------------------------------- key vs the data --
    //
    // Does APP_KEY still open what APP_KEY encrypted?
    //
    // A database and an .env travel separately, and the commonest way they get
    // separated is moving to another PC: copy the data, run key:generate on
    // the new machine, and every encrypted value in the database becomes
    // unreadable at once. Nothing announced it. The terminals simply stopped
    // authenticating and the fingerprints simply stopped matching, each of
    // which looks like its own hardware fault, and neither of which is.
    //
    // One decryption of each kind settles it in milliseconds.
    heading('Encryption key');

    // Every ACTIVE key, not one arbitrary row.
    //
    // The first version of this took a single sample with `LIMIT 1` and no
    // status filter, and rotating a key is exactly what makes that wrong.
    // Rotation leaves the superseded row behind with status 'rotating' and
    // revoked_at still NULL, so the sample could land on a key that has been
    // replaced — unreadable by design after an APP_KEY change, and no longer
    // used by anything. It then reported a failure that had already been
    // fixed, which is worse than reporting nothing: it sends somebody back to
    // repair what they just repaired.
    //
    // The useful question is not "is some row readable" but "can every key a
    // terminal might present still be read", and, when the answer is no,
    // which terminals. Superseded and revoked rows are ignored throughout;
    // they are history, and history being unreadable costs nothing.
    $activeKeys = $db->select(
        "SELECT k.api_key_id, k.hmac_secret_encrypted, d.device_id
           FROM api_keys k
      LEFT JOIN devices d ON d.id = k.device_row_id
          WHERE k.status = 'active'
            AND k.revoked_at IS NULL
            AND k.hmac_secret_encrypted IS NOT NULL"
    );

    $unreadableDevices = [];

    foreach ($activeKeys as $row) {
        try {
            Crypto::decrypt((string) $row['hmac_secret_encrypted']);
        } catch (Throwable $e) {
            $unreadableDevices[] = (string) ($row['device_id'] ?? ('key #' . $row['api_key_id']));
        }
    }

    $templatesTotal      = 0;
    $templatesUnreadable = 0;

    if ($db->hasColumn('fingerprint_templates', 'template_data')) {
        foreach ($db->select('SELECT template_data FROM fingerprint_templates
                               WHERE template_data IS NOT NULL') as $row) {
            $templatesTotal++;

            try {
                Crypto::decrypt((string) $row['template_data']);
            } catch (Throwable $e) {
                $templatesUnreadable++;
            }
        }
    }

    if ($activeKeys === []) {
        out(sprintf('  %-44s %s', 'terminal keys', 'none issued yet'), 'grey');
    } else {
        $check(
            $unreadableDevices === [],
            'APP_KEY decrypts every terminal key',
            $unreadableDevices === []
                ? count($activeKeys) . ' of ' . count($activeKeys) . ' readable'
                : count($unreadableDevices) . ' of ' . count($activeKeys) . ' UNREADABLE'
        );
    }

    if ($templatesTotal === 0) {
        out(sprintf('  %-44s %s', 'fingerprint templates', 'none stored yet'), 'grey');
    } else {
        $check(
            $templatesUnreadable === 0,
            'APP_KEY decrypts every fingerprint template',
            $templatesUnreadable === 0
                ? $templatesTotal . ' of ' . $templatesTotal . ' readable'
                : $templatesUnreadable . ' of ' . $templatesTotal . ' UNREADABLE'
        );
    }

    if ($unreadableDevices !== [] || $templatesUnreadable > 0) {
        $note('APP_KEY in .env is not the key this data was encrypted with — the usual');
        $note('cause is a database copied to another PC where new keys were generated.');
        $note('');

        if ($unreadableDevices !== []) {
            $note('Terminals that cannot authenticate: ' . implode(', ', $unreadableDevices));
            $note('Each is repaired by regenerating its provisioning file from Admin → IoT');
            $note('Devices, which issues a key under the CURRENT APP_KEY. That also resets');
            $note('the device to unclaimed, so paste the new claim token in as well.');
        }

        if ($templatesUnreadable > 0) {
            $note($templatesUnreadable . ' fingerprint template(s) cannot be recovered this way and');
            $note('must be enrolled again.');
        }

        $note('');
        $note('Restoring the ORIGINAL .env fixes all of it at once and loses nothing.');
        $note('See docs/MOVING-TO-ANOTHER-PC.md');
    } elseif ($activeKeys === [] && $templatesTotal === 0) {
        $note('Nothing encrypted is stored yet, so there is nothing to verify. This is');
        $note('normal on a fresh installation.');
    }

    heading('Fingerprints');

    $teachers = (int) $db->scalar("SELECT COUNT(*) FROM teachers WHERE deleted_at IS NULL AND status = 'active'");
    $enrolled = (int) $db->scalar(
        'SELECT COUNT(*) FROM fingerprint_templates fp
           JOIN teachers t ON t.teacher_id = fp.teacher_id
          WHERE t.deleted_at IS NULL'
    );

    if ($teachers === 0) {
        $warn('No teacher records', 'nothing can be enrolled; add one under Teachers');
        $note('A user account with the teacher role is not a teacher record. Schedules,');
        $note('sections and fingerprints all attach to the teacher record, not the account.');
    } else {
        out(sprintf('  %-16s %d of %d active teachers', 'enrolled', $enrolled, $teachers), 'grey');
    }

    // The page lists "awaiting enrolment" from the template table and the
    // teacher's own status column. When those two disagree a teacher can be
    // shown twice, or vanish from both lists — worth naming explicitly.
    $drift = $db->select(
        "SELECT t.teacher_id, t.employee_number, t.last_name, t.fingerprint_status,
                (fp.fingerprint_id IS NOT NULL) AS has_template
           FROM teachers t
      LEFT JOIN fingerprint_templates fp ON fp.teacher_id = t.teacher_id
          WHERE t.deleted_at IS NULL
            AND ((t.fingerprint_status = 'enrolled' AND fp.fingerprint_id IS NULL)
              OR (t.fingerprint_status = 'not_enrolled' AND fp.fingerprint_id IS NOT NULL))"
    );

    if ($drift === []) {
        ok('Teacher status and template records agree');
    } else {
        foreach ($drift as $row) {
            $warn(
                'Inconsistent: ' . $row['last_name'] . ' (' . $row['employee_number'] . ')',
                'status says ' . $row['fingerprint_status'] . ', template '
                    . ($row['has_template'] ? 'exists' : 'missing')
            );
        }

        $note('Re-enrol or delete the enrolment on the Fingerprints page to resolve.');
    }

    // ------------------------------------------------------------ devices --
    heading('Terminals');

    // Module health is only selected where migration 019 has run, so doctor
    // still works on a database that is behind the code — which is exactly
    // the situation somebody runs doctor to diagnose.
    $hasModuleHealth = $db->hasColumn('devices', 'rfid_ok');

    $devices = $db->select(
        'SELECT device_id, mac_address, status, claim_status, last_heartbeat_at, classroom_id'
        . ($hasModuleHealth ? ', rfid_ok, fingerprint_ok' : ', NULL AS rfid_ok, NULL AS fingerprint_ok')
        . ' FROM devices WHERE deleted_at IS NULL ORDER BY device_id'
    );

    if ($devices === []) {
        $warn('No terminals registered', 'add one under Devices before flashing an ESP32');
    }

    $heartbeatWindow = (int) Config::get('attendance.device.offline_after_sec', 90);

    foreach ($devices as $device) {
        $seen = $device['last_heartbeat_at'] === null
            ? 'never seen'
            : 'last seen ' . $device['last_heartbeat_at'];

        $stale = $device['last_heartbeat_at'] !== null
            && (Clock::timestamp() - strtotime((string) $device['last_heartbeat_at'])) > $heartbeatWindow;

        $detail = $device['status'] . ', ' . $device['claim_status'] . ', ' . $seen;

        if ($device['claim_status'] !== 'claimed') {
            $warn((string) $device['device_id'], $detail . ' — the board has not claimed its API key yet');

            // Both halves of what the claim checks, printed together, because
            // CLAIM_IDENTITY_MISMATCH does not say which of the two is wrong
            // and the answer is always "compare these against the board".
            $note('registered MAC: ' . $device['mac_address'] . ' — this must match the address the');
            $note('sketch prints at boot, exactly, or the claim is refused.');
        } elseif ($device['classroom_id'] === null) {
            $warn((string) $device['device_id'], $detail . ' — no classroom assigned, so no schedule can match');
        } elseif ($device['last_heartbeat_at'] === null || $stale) {
            $warn((string) $device['device_id'], $detail . ' — not currently reporting');
        } elseif ($device['rfid_ok'] !== null
               && ((int) $device['rfid_ok'] === 0 || (int) $device['fingerprint_ok'] === 0)) {
            // Reporting on schedule and still unable to do its job. This is
            // the state that used to be invisible from every page: online by
            // every measure the server had, while reading nothing at all.
            $dead = (int) $device['rfid_ok'] === 0 && (int) $device['fingerprint_ok'] === 0
                ? 'neither module answered at boot'
                : ((int) $device['rfid_ok'] === 0
                    ? 'the card reader did not answer at boot'
                    : 'the fingerprint sensor did not answer at boot');

            $warn((string) $device['device_id'], $detail . ' — online, but ' . $dead);
            $note('It is connected and reporting, so this is wiring or power at the terminal,');
            $note('not the network. Its Serial Monitor prints the fault on every boot.');
        } else {
            ok(sprintf('%-20s %s', $device['device_id'], $detail));
        }
    }

    // ----------------------------------------------------------- realtime --
    // -------------------------------------------------------- the website --
    //
    // The check that was missing, and the one everything else depends on.
    //
    // doctor probed the realtime server but never the site itself, so an
    // installation whose web server simply was not running passed every check
    // and reported nothing wrong. The terminals then failed with "could not
    // connect", which reads as a network fault and sends the search to the
    // Wi-Fi, the IP address and the router.
    //
    // XAMPP makes it easy to believe the site is up when it is not. Its
    // control panel shows Apache running in green on ports 80 and 443 — and
    // Apache does not serve this system. start.bat does, on 8080, in its own
    // window. Two green rows in XAMPP and a stopped site look identical from
    // the outside.
    heading('The website');

    $webPort = 8080;
    $appUrl  = (string) Env::get('APP_URL', '');

    if ($appUrl !== '') {
        $parsedPort = parse_url($appUrl, PHP_URL_PORT);
        if (is_int($parsedPort)) {
            $webPort = $parsedPort;
        } elseif (str_starts_with($appUrl, 'https://')) {
            $webPort = 443;
        } elseif (str_starts_with($appUrl, 'http://')) {
            $webPort = 80;
        }
    }

    $site = @fsockopen('127.0.0.1', $webPort, $siteErrno, $siteErrstr, 1.5);

    if (is_resource($site)) {
        fclose($site);
        $check(true, 'Website is listening on port ' . $webPort);

        // Reaching it from this PC proves nothing about reaching it from a
        // classroom. A terminal connects to the LAN address, and a server
        // bound only to loopback, or a firewall rule that never got its
        // "allow", answers on 127.0.0.1 and refuses everything else.
        //
        // That failure is invisible from the browser on the same machine,
        // which is where anyone naturally checks, and it presents at the
        // terminal as "could not connect" — indistinguishable from a stopped
        // server. Probing the machine's own LAN address separates the two.
        $lanIp = null;

        $viaHostname = @gethostbyname(@gethostname() ?: '');

        if (is_string($viaHostname)
            && filter_var($viaHostname, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4)
            && !str_starts_with($viaHostname, '127.')
        ) {
            $lanIp = $viaHostname;
        }

        if ($lanIp === null) {
            // No packets leave: connecting a UDP socket only fixes the local
            // end, and the address it picks is the one this machine would
            // send from. Needs a route to exist, nothing more.
            $probe = @stream_socket_client('udp://192.0.2.1:53', $e1, $e2, 0.5);

            if (is_resource($probe)) {
                $local = (string) @stream_socket_get_name($probe, false);
                fclose($probe);

                $candidate = substr($local, 0, (int) strrpos($local, ':') ?: 0);

                if (filter_var($candidate, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4)
                    && !str_starts_with($candidate, '127.')
                ) {
                    $lanIp = $candidate;
                }
            }
        }

        if ($lanIp === null) {
            $note('This PC\'s LAN address could not be determined here, so whether a');
            $note('terminal can reach the site was not tested. Run ipconfig and open');
            $note('http://<that address>:' . $webPort . ' in a browser to check by hand.');
        } else {
            $lanSocket = @fsockopen($lanIp, $webPort, $lanErrno, $lanErrstr, 1.5);

            if (is_resource($lanSocket)) {
                fclose($lanSocket);
                $check(true, 'Reachable from the network on ' . $lanIp . ':' . $webPort);
                $note('That is the address the terminals must have in LS_SERVER_URL,');
                $note('written in full: http://' . $lanIp . ':' . $webPort);
            } else {
                $check(false, 'Reachable from the network on ' . $lanIp . ':' . $webPort,
                    $lanErrstr ?: 'refused');

                $note('The site answers on this PC but not on its own network address, so no');
                $note('terminal can reach it while the browser here works perfectly — which');
                $note('is why this looks like a fault at the board.');
                $note('');
                $note('Windows Firewall is the usual cause: it asks once whether to allow');
                $note('php.exe, and a "Cancel" or a "Public networks only" answer produces');
                $note('exactly this. Allow php.exe on Private networks.');
                $note('');
                $note('The other cause is a server bound to localhost. start.bat binds');
                $note('0.0.0.0 deliberately, so this points at the firewall unless the site');
                $note('is being started some other way.');
            }
        }
    } else {
        $check(false, 'Website is listening on port ' . $webPort,
            $siteErrstr ?: 'nothing is listening');

        $note('Nothing is serving the system right now, so no browser and no terminal');
        $note('can reach it. Run start.bat — it serves the site on port ' . $webPort . ' and');
        $note('must stay open while the system is in use.');
        $note('');
        $note('XAMPP\'s Apache does NOT serve L-SIAMS, so Apache showing green on ports');
        $note('80 and 443 in the XAMPP Control Panel does not mean the site is up. Only');
        $note('MySQL is needed from XAMPP; start.bat provides the web server itself.');
    }

    heading('Live updates');

    $realtimeEnabled = (bool) Config::get('realtime.enabled', true);
    $sseEnabled      = (bool) Config::get('realtime.fallback.sse_enabled', true);
    $wsHost          = (string) Config::get('realtime.ws_host', '127.0.0.1');
    $wsPort          = (int) Config::get('realtime.ws_port', 8443);

    if (!$realtimeEnabled) {
        $note('Realtime is switched off; every page falls back to short polling.');
    } else {
        // 0.0.0.0 is a bind address, not something to connect to.
        $probeHost = in_array($wsHost, ['0.0.0.0', '::'], true) ? '127.0.0.1' : $wsHost;
        $socket    = @fsockopen($probeHost, $wsPort, $errno, $errstr, 1.5);

        if (is_resource($socket)) {
            fclose($socket);
            ok('Realtime server is listening on ' . $probeHost . ':' . $wsPort);
        } else {
            $warn(
                'Realtime server not reachable',
                $probeHost . ':' . $wsPort . ' — ' . ($errstr ?: 'connection refused')
            );
            $note('The pill in the top bar will read "Polling" instead of "Live". Every page');
            $note('still works; updates arrive on a few-second refresh rather than instantly.');
            $note('start.bat opens it in its own window — check that window is still open.');
        }
    }

    $note('Server-Sent Events are ' . ($sseEnabled ? 'on' : 'off (correct for start.bat)') . '.');

    // ------------------------------------------------------------ storage --
    heading('Storage');

    foreach (['storage/logs', 'storage/reports', 'storage/backups', 'public/uploads'] as $relative) {
        $path = BASE_PATH . '/' . $relative;

        if (!is_dir($path)) {
            $warn($relative, 'missing — it is created on first use');
            continue;
        }

        $check(is_writable($path), $relative . ' writable');
    }

    doctorSummary($problems, $warnings);
}

/**
 * @param list<string> $problems
 * @param list<string> $warnings
 */
function doctorSummary(array $problems, array $warnings): void
{
    heading('Summary');

    if ($problems === [] && $warnings === []) {
        out('  Nothing to report. Everything checked is healthy.', 'green');
        out('');

        return;
    }

    if ($problems !== []) {
        out('  ' . count($problems) . ' problem(s) that will stop something from working:', 'red');

        foreach ($problems as $problem) {
            out('    - ' . $problem, 'red');
        }
    }

    if ($warnings !== []) {
        out('  ' . count($warnings) . ' thing(s) worth knowing about:', 'yellow');

        foreach ($warnings as $warning) {
            out('    - ' . $warning, 'yellow');
        }
    }

    out('');
}

/**
 * Static assurance for the Part 20.4 acceptance criterion:
 * "rand(), mt_rand(), and uniqid() appear nowhere in the key path".
 */
function commandAuditKeys(): void
{
    heading('Auditing the key generation path');

    $keyPathFiles = [
        'app/Core/Crypto.php',
        'app/Services/ApiKeyService.php',
        'app/Services/SessionService.php',
        'app/Services/PasswordPolicyService.php',
        'app/Services/DeviceService.php',
        'app/Services/RealtimeService.php',
        'app/Services/CsrfService.php',
    ];

    $forbidden = ['mt_rand', 'rand(', 'uniqid', 'shuffle(', 'str_shuffle', 'array_rand'];
    $problems  = 0;

    foreach ($keyPathFiles as $relative) {
        $path = BASE_PATH . '/' . $relative;

        if (!is_file($path)) {
            out('  ⚠ missing: ' . $relative, 'yellow');
            continue;
        }

        // Scan tokens, not raw text. A regex over the file body cannot tell a
        // call from the comment above it explaining why the call is absent, and
        // it flagged exactly those comments — an audit that reports a problem
        // where the code is correct trains people to ignore it, which is worse
        // than not running it at all. The tokenizer sees only real function
        // names, so comments and string literals cannot produce a finding.
        $tokens = @token_get_all((string) file_get_contents($path));
        $found  = [];

        $banned = array_map(
            static fn (string $needle): string => strtolower(rtrim($needle, '(')),
            $forbidden
        );

        foreach ($tokens as $index => $token) {
            if (!is_array($token) || $token[0] !== T_STRING) {
                continue;
            }

            $name = strtolower($token[1]);

            if (!in_array($name, $banned, true)) {
                continue;
            }

            // A bare identifier is not a call. Look ahead past whitespace for
            // the opening parenthesis, so a method named `shuffle` on some
            // object, or a constant, is not mistaken for the global function.
            $next = $index + 1;

            while (isset($tokens[$next]) && is_array($tokens[$next]) && $tokens[$next][0] === T_WHITESPACE) {
                $next++;
            }

            if (($tokens[$next] ?? null) !== '(') {
                continue;
            }

            // `$this->rand()` and `Foo::rand()` are not the global function.
            $previous = $index - 1;

            while (isset($tokens[$previous]) && is_array($tokens[$previous]) && $tokens[$previous][0] === T_WHITESPACE) {
                $previous--;
            }

            $before = $tokens[$previous] ?? null;

            if (is_array($before) && in_array($before[0], [T_OBJECT_OPERATOR, T_DOUBLE_COLON, T_FUNCTION], true)) {
                continue;
            }

            $found[$name] = $name;
        }

        $found = array_values($found);

        if ($found === []) {
            ok(sprintf('%-46s clean', $relative));
        } else {
            out(sprintf('  ✗ %-44s uses %s', $relative, implode(', ', $found)), 'red');
            $problems++;
        }
    }

    out('');

    $usesCsprng = str_contains((string) file_get_contents(BASE_PATH . '/app/Core/Crypto.php'), 'random_bytes(');

    $usesCsprng
        ? ok('Crypto::randomBytes() is backed by random_bytes().')
        : out('  ✗ Crypto does not call random_bytes().', 'red');

    // Sample the generator to confirm it produces distinct, well-formed keys.
    heading('Sampling 1,000 generated key identifiers');

    $seen = [];

    for ($i = 0; $i < 1000; $i++) {
        $seen[] = 'lsk_' . Crypto::randomBase62(8) . '.' . Crypto::randomBase62(32);
    }

    $unique = count(array_unique($seen));

    $unique === 1000
        ? ok('1,000 / 1,000 keys unique.')
        : out(sprintf('  ✗ only %d / 1000 unique.', $unique), 'red');

    $lengths = array_unique(array_map('strlen', $seen));
    ok('Key length: ' . implode(', ', $lengths) . ' characters.');

    out('');
    $problems === 0 ? ok('Key path audit passed.') : fail($problems . ' file(s) failed the audit.');
}

function commandCreateAdmin(): void
{
    heading('Create an administrator account');

    $db = Database::instance();

    $role = $db->selectOne("SELECT role_id FROM roles WHERE role_slug = 'administrator'");

    if ($role === null) {
        fail('The administrator role does not exist. Run "php bin/console seed" first.');
    }

    $fullName = prompt('Full name');
    $username = strtolower(prompt('Username'));
    $email    = strtolower(prompt('Email'));

    if ($fullName === '' || $username === '' || $email === '') {
        fail('All fields are required.');
    }

    if (preg_match('/^[a-z0-9._-]{4,32}$/', $username) !== 1) {
        fail('Username must be 4–32 characters: letters, numbers, dot, underscore or hyphen.');
    }

    if (filter_var($email, FILTER_VALIDATE_EMAIL) === false) {
        fail('That email address is not valid.');
    }

    if ($db->scalar('SELECT 1 FROM users WHERE username = :u OR email = :e LIMIT 1',
        ['u' => $username, 'e' => $email]) !== null) {
        fail('That username or email address is already registered.');
    }

    $password = prompt('Password (blank to generate one)', true);
    $generated = false;

    if ($password === '') {
        $password  = App\Services\PasswordPolicyService::generate();
        $generated = true;
    } else {
        $issues = App\Services\PasswordPolicyService::check($password, [$username, $email, $fullName]);

        if ($issues !== []) {
            out('');
            foreach ($issues as $issue) {
                out('  ✗ ' . $issue, 'red');
            }
            exit(1);
        }

        if (prompt('Confirm password', true) !== $password) {
            fail('Passwords do not match.');
        }
    }

    $hash = Hash::make($password);

    $userId = (int) $db->transaction(static function (Database $db) use ($role, $username, $email, $hash, $fullName, $generated): string {
        $id = $db->insert('users', [
            'role_id'              => (int) $role['role_id'],
            'username'             => $username,
            'email'                => $email,
            'password_hash'        => $hash,
            'full_name'            => $fullName,
            'status'               => 'active',
            // Only force a change when the console generated the password.
            // Somebody who typed their own, at this prompt, seconds ago has
            // already chosen it — making them choose again teaches nothing and
            // is one more thing to go wrong in front of an audience. A
            // generated password is different: it has been printed to a
            // terminal and possibly a scrollback buffer, so it must not stay.
            'must_change_password' => $generated ? 1 : 0,
            'password_changed_at'  => Clock::nowString(),
            'created_at'           => Clock::nowString(),
            'updated_at'           => Clock::nowString(),
        ]);

        $db->insert('password_history', [
            'user_id'       => (int) $id,
            'password_hash' => $hash,
            'created_at'    => Clock::nowString(),
        ]);

        return $id;
    });

    out('');
    ok('Administrator #' . $userId . ' created.');
    out('');
    out('  Username: ' . $username, 'cyan');

    if ($generated) {
        out('  Password: ' . $password, 'cyan');
        out('');
        out('  This is the only time the password is shown. You will be asked', 'yellow');
        out('  to change it the first time you sign in.', 'yellow');
    } else {
        out('  Password: (as entered)', 'grey');
    }

    out('');
}

/**
 * Write a single importable SQL file for people who install through
 * phpMyAdmin rather than a shell.
 *
 * The migrations remain the source of truth — this is a build artefact
 * regenerated from a freshly migrated and reference-seeded database, so it can
 * never describe a schema the migrations do not produce. It deliberately omits
 * user accounts and any student, teacher or attendance data: a schema file that
 * shipped a known login would be a backdoor in every installation that used it.
 */
/**
 * Turn a .sql.gz.lsiams (or older .sql.gz.enc) backup archive into readable SQL.
 *
 * The admin Backups page can only restore archives it has a database row for,
 * and that row lives in the database — so it is missing precisely when the
 * backup is needed. This reads the file directly. It needs the APP_KEY the
 * archive was written with, which is why .env must be kept alongside the
 * backups and never regenerated while an archive still matters.
 *
 * @param list<string> $arguments
 */
function commandBackupDecrypt(array $arguments): void
{
    $paths  = array_values(array_filter($arguments, static fn (string $a): bool => !str_starts_with($a, '--')));
    $source = $paths[0] ?? '';

    if ($source === '') {
        fail("Usage: php bin/console backup:decrypt <file.sql.gz.lsiams> [output.sql]\n"
           . '  Writes the SQL next to the archive when no output path is given.');
    }

    if (!is_file($source)) {
        $candidate = BASE_PATH . '/database/backups/' . basename($source);

        if (!is_file($candidate)) {
            fail('No such file: ' . $source);
        }

        $source = $candidate;
    }

    // Both suffixes: archives written before the extension changed are
    // still '.sql.gz.enc' and must keep decrypting exactly as they did.
    $target = $paths[1] ?? preg_replace('/\.sql\.gz\.(enc|lsiams)$/', '.sql', $source);

    if (!is_string($target) || $target === '' || $target === $source) {
        $target = $source . '.sql';
    }

    heading('Decrypting ' . basename($source));

    try {
        $sql = BackupService::decryptFile($source);
    } catch (Throwable $e) {
        out('');
        out('  If the message mentions decryption, the APP_KEY in .env is not the one', 'grey');
        out('  this archive was written with. There is no way around that.', 'grey');
        out('');
        fail($e->getMessage());
    }

    if (file_put_contents($target, $sql) === false) {
        fail('Could not write ' . $target);
    }

    @chmod($target, 0600);

    ok(number_format(strlen($sql)) . ' bytes written to ' . $target);
    out('');
    out('  Load it with:  php bin/console db:import ' . escapeshellarg($target), 'cyan');
    out('  It contains real data — delete it once the import has worked.', 'grey');
}

/**
 * Import a .sql file — including a phpMyAdmin export — into the configured
 * database.
 *
 * phpMyAdmin's own importer fails on files it happily produces: it writes the
 * tables alphabetically and adds every foreign key at the end, so a partial
 * export or a re-run against existing tables dies half way through with a
 * message that names an errno and nothing else. This importer switches the
 * constraint checks off for the duration, ignores any CREATE DATABASE / USE
 * lines so the file always lands in the database named in .env, and when a
 * statement does fail it prints the statement instead of a number.
 *
 * @param list<string> $arguments
 * @param list<string> $flags
 */
function commandDbImport(array $arguments, array $flags): void
{
    $paths = array_values(array_filter($arguments, static fn (string $a): bool => !str_starts_with($a, '--')));
    $path  = $paths[0] ?? '';

    if ($path === '') {
        fail("Usage: php bin/console db:import <file.sql> [--fresh]\n"
           . '  --fresh  drop every existing table and view first');
    }

    if (!is_file($path)) {
        $candidate = BASE_PATH . '/' . ltrim($path, '/\\');

        if (!is_file($candidate)) {
            fail('No such file: ' . $path);
        }

        $path = $candidate;
    }

    $sql = (string) file_get_contents($path);

    // phpMyAdmin writes UTF-8 with a byte order mark when the browser asks for
    // one. MySQL reads it as three junk characters in front of the first
    // statement and reports a syntax error at line 1.
    $sql = (string) preg_replace('/^\xEF\xBB\xBF/', '', $sql);

    $config   = (array) Config::get('database', []);
    $database = (string) ($config['database'] ?? '');

    heading('Importing ' . basename($path) . ' into ' . $database);

    $db = Database::instance();

    if (in_array('--fresh', $flags, true)) {
        $db->pdo()->exec('SET FOREIGN_KEY_CHECKS = 0');

        foreach ($db->select('SHOW FULL TABLES WHERE Table_type = "VIEW"') as $row) {
            $db->pdo()->exec(sprintf('DROP VIEW IF EXISTS `%s`', (string) array_values($row)[0]));
        }

        foreach ($db->select('SHOW FULL TABLES WHERE Table_type = "BASE TABLE"') as $row) {
            $db->pdo()->exec(sprintf('DROP TABLE IF EXISTS `%s`', (string) array_values($row)[0]));
        }

        ok('  Existing tables dropped.');
    }

    $statements = splitSqlStatements($sql);

    if ($statements === []) {
        fail('The file contains no SQL statements. If you pasted it out of a browser, check it was not truncated.');
    }

    // Anything that would move the import to a different database is dropped:
    // the target is whatever .env points at, and nothing in the file gets to
    // override that.
    $redirects = 0;
    $executed  = 0;

    $db->pdo()->exec('SET FOREIGN_KEY_CHECKS = 0');
    $db->pdo()->exec('SET UNIQUE_CHECKS = 0');
    $db->pdo()->exec("SET SQL_MODE = 'NO_AUTO_VALUE_ON_ZERO'");

    foreach ($statements as $index => $statement) {
        $head = ltrim($statement);

        if (preg_match('/^(USE\b|CREATE\s+DATABASE\b|CREATE\s+SCHEMA\b|DROP\s+DATABASE\b|DROP\s+SCHEMA\b)/i', $head) === 1) {
            $redirects++;
            continue;
        }

        try {
            $db->pdo()->exec($statement);
            $executed++;
        } catch (Throwable $e) {
            $db->pdo()->exec('SET UNIQUE_CHECKS = 1');
            $db->pdo()->exec('SET FOREIGN_KEY_CHECKS = 1');

            out('');
            out('  Statement ' . ($index + 1) . ' of ' . count($statements) . ' failed:', 'yellow');
            out('');

            foreach (array_slice(preg_split('/\n/', trim($statement)) ?: [], 0, 8) as $line) {
                out('    ' . mb_strimwidth($line, 0, 160, '…'), 'grey');
            }

            out('');
            fail($e->getMessage());
        }
    }

    $db->pdo()->exec('SET UNIQUE_CHECKS = 1');
    $db->pdo()->exec('SET FOREIGN_KEY_CHECKS = 1');

    // A file written against an older release leaves the newer migrations
    // unapplied, and the pages that need them break in ways that look nothing
    // like an import problem. Say so here rather than letting them find out.
    $pending = [];

    try {
        ensureMigrationsTable($db);
        $applied = array_column($db->select('SELECT migration FROM schema_migrations'), 'migration');

        foreach (discoverMigrations() as $migration) {
            if (!in_array($migration['name'], $applied, true)) {
                $pending[] = $migration['name'];
            }
        }
    } catch (Throwable) {
        // Nothing to report if the table could not be read.
    }

    out('');
    ok($executed . ' statement(s) executed.');

    if ($redirects > 0) {
        out('  ' . $redirects . ' CREATE DATABASE / USE statement(s) ignored — the target came from .env.', 'grey');
    }

    if ($pending !== []) {
        out('');
        out('  ' . count($pending) . ' migration(s) in this release are not in that file:', 'yellow');

        foreach ($pending as $name) {
            out('    ' . $name, 'yellow');
        }

        out('');
        out('  Apply them now:  php bin/console migrate', 'cyan');
    }
}

/**
 * Move the application's clock, for testing a schedule without waiting for it.
 *
 *   time:shift "+2 hours"      run two hours ahead
 *   time:shift "next monday 08:05"
 *   time:shift --clear         back to real time
 *   time:shift                 show where the clock currently is
 *
 * @param list<string> $arguments
 * @param list<string> $flags
 */
function commandTimeShift(array $arguments, array $flags): void
{
    $envFile = BASE_PATH . '/.env';

    if (!is_file($envFile)) {
        fail('.env does not exist yet. Run install first.');
    }

    $values = array_values(array_filter($arguments, static fn (string $a): bool => !str_starts_with($a, '--')));
    $clear  = in_array('--clear', $flags, true);
    $spec   = $clear ? '' : trim($values[0] ?? '');

    heading('Application clock');

    // No argument: report, change nothing.
    if ($spec === '' && !$clear) {
        $current = Clock::offset();

        out('  Real time         ' . Clock::real()->format('D d M Y H:i:s'));
        out('  Application time  ' . Clock::now()->format('D d M Y H:i:s'), $current === '' ? '' : 'yellow');
        out('');

        $current === ''
            ? ok('The clock is not shifted.')
            : out('  Shift: ' . $current, 'yellow');

        if (Env::get('APP_ENV', 'production') === 'production' && Env::get('APP_CLOCK_OFFSET', '') !== '') {
            out('');
            out('  APP_CLOCK_OFFSET is set but ignored — APP_ENV is production.', 'yellow');
        }

        return;
    }

    if ($spec !== '' && !Clock::isValidOffset($spec)) {
        // "+8h" is the mistake worth naming: PHP parses it, ignores it, and
        // leaves the clock where it was, so it used to be accepted and then
        // quietly do nothing.
        fail('"' . $spec . '" does not move the clock. Single-letter units are '
           . 'silently ignored by PHP — write the unit out: "+8 hours", not "+8h"; '
           . '"+30 minutes", not "+30m". "next monday 08:05" also works.');
    }

    $contents = (string) file_get_contents($envFile);

    $contents = preg_match('/^APP_CLOCK_OFFSET=.*$/m', $contents) === 1
        ? (string) preg_replace('/^APP_CLOCK_OFFSET=.*$/m', 'APP_CLOCK_OFFSET=' . $spec, $contents)
        : rtrim($contents) . PHP_EOL . 'APP_CLOCK_OFFSET=' . $spec . PHP_EOL;

    file_put_contents($envFile, $contents);
    @chmod($envFile, 0600);

    if ($spec === '') {
        ok('Cleared. The application is back on real time.');
    } else {
        ok('Shift set to "' . $spec . '".');
        out('  Real time is ' . Clock::real()->format('D d M Y H:i:s')
            . ', so the application will read '
            . Clock::real()->modify($spec)->format('D d M Y H:i:s') . '.', 'grey');
    }

    out('');
    out('  Restart start.bat — the running server read .env when it started.', 'cyan');

    if (Env::get('APP_ENV', 'production') === 'production' && $spec !== '') {
        out('');
        out('  APP_ENV is production, so this will be ignored. Set APP_ENV=local in', 'yellow');
        out('  .env while you are testing, and put it back afterwards.', 'yellow');
    }
}

/**
 * Erase a user row and everything that points at it.
 *
 * This exists because the database will not let you do it by hand, and the
 * ways round that by hand are worse than the problem. `audit_logs`,
 * `login_history` and `security_logs` each hold the user with ON DELETE
 * RESTRICT *and* carry a BEFORE DELETE trigger that raises SQLSTATE 45000, so
 * the only route through is to drop those triggers first. An administrator
 * doing that in phpMyAdmin who then hits an error partway — or simply closes
 * the tab — leaves the audit table permanently unprotected, and nothing
 * anywhere says so. That is a far worse outcome than the stuck row they were
 * trying to fix.
 *
 * So the trigger drop happens here, between a confirmation that shows exactly
 * what will be destroyed and a `finally` that puts the triggers back whatever
 * happens. DDL commits implicitly in MariaDB, so a transaction cannot cover
 * this; the `finally` is the guarantee, not the transaction.
 *
 * Archiving remains the right answer almost every time — it ends the sessions,
 * blocks the login and keeps the history. This is for the account created by
 * mistake that should never have existed.
 *
 * @param list<string> $arguments
 * @param list<string> $flags
 */
function commandUserPurge(array $arguments, array $flags): void
{
    $db     = Database::instance();
    $userId = (int) ($arguments[0] ?? 0);

    if ($userId <= 0) {
        fail('Give the numeric user id: php bin/console user:purge 3');
    }

    $user = $db->selectOne(
        'SELECT u.*, r.role_slug, r.role_name
           FROM users u JOIN roles r ON r.role_id = u.role_id
          WHERE u.user_id = :id',
        ['id' => $userId]
    );

    if ($user === null) {
        fail(sprintf('No user with id %d.', $userId));
    }

    heading(sprintf('Purge user %d — %s', $userId, (string) $user['username']));

    out(sprintf('  %-14s %s', 'Name', (string) ($user['full_name'] ?? '—')), 'grey');
    out(sprintf('  %-14s %s', 'Email', (string) ($user['email'] ?? '—')), 'grey');
    out(sprintf('  %-14s %s', 'Role', (string) $user['role_name']), 'grey');
    out(sprintf('  %-14s %s', 'Status', (string) $user['status']), 'grey');

    // The same rule the application enforces. Losing the last administrator
    // locks everybody out with no recovery short of editing the database, and
    // this command is meant to keep people out of the database.
    if (strtolower((string) $user['role_slug']) === 'administrator') {
        $remaining = (int) $db->scalar(
            "SELECT COUNT(*) FROM users u JOIN roles r ON r.role_id = u.role_id
              WHERE r.role_slug = 'administrator' AND u.status = 'active'
                AND u.deleted_at IS NULL AND u.user_id <> :id",
            ['id' => $userId]
        );

        if ($remaining === 0) {
            fail('This is the last active administrator. Purging it would lock everyone out permanently.');
        }
    }

    // Everything that would be destroyed outright, rather than detached. These
    // are the tables holding the user with ON DELETE RESTRICT.
    $destroys = [
        'audit_logs'                     => 'user_id',
        'login_history'                  => 'user_id',
        'security_logs'                  => 'user_id',
        'attendance_modifications'       => 'administrator_id',
        'student_section_history'        => 'performed_by',
        'generated_reports'              => 'generated_by',
        'teacher_department_exceptions'  => 'granted_by',
        'teacher_grade_level_exceptions' => 'granted_by',
    ];

    heading('Rows that will be destroyed permanently');

    $total = 0;

    foreach ($destroys as $table => $column) {
        $count = (int) $db->scalar(
            sprintf('SELECT COUNT(*) FROM `%s` WHERE `%s` = :id', $table, $column),
            ['id' => $userId]
        );

        $total += $count;

        out(sprintf('  %-34s %6d', $table, $count), $count > 0 ? 'yellow' : 'grey');
    }

    out('');
    out(sprintf('  %-34s %6d', 'total', $total), $total > 0 ? 'yellow' : 'grey');

    if ($total > 0) {
        out('');
        out('  These cannot be recovered from a backup taken after the purge.', 'yellow');
        out('  Archiving instead keeps every one of them and still blocks the login.', 'grey');
    }

    if (!in_array('--force', $flags, true)) {
        out('');
        out('  Dry run — nothing has been changed.', 'cyan');
        out('  Re-run with --force to carry it out:', 'grey');
        out(sprintf('    php bin/console user:purge %d --force', $userId), 'grey');
        out('');

        return;
    }

    out('');
    $typed = prompt(sprintf('  Type the username "%s" to confirm', (string) $user['username']));

    if (!hash_equals((string) $user['username'], $typed)) {
        fail('Confirmation did not match. Nothing was changed.');
    }

    // Recorded before the rows go, because afterwards there is nothing left to
    // describe and no way to tell the purge happened at all.
    App\Services\AuditService::log(
        'user.purged',
        'user_management',
        'user',
        $userId,
        [
            'username' => (string) $user['username'],
            'email'    => (string) ($user['email'] ?? ''),
            'role'     => (string) $user['role_name'],
            'status'   => (string) $user['status'],
        ],
        null,
        sprintf(
            'Account "%s" (id %d) purged from the console along with %d referencing row(s).',
            (string) $user['username'],
            $userId,
            $total
        ),
        'success',
        null
    );

    $guards = ['audit_logs' => 'trg_audit_no_delete',
               'security_logs' => 'trg_security_no_delete',
               'login_history' => 'trg_login_history_no_delete'];

    heading('Purging');

    try {
        foreach ($guards as $trigger) {
            $db->execute(sprintf('DROP TRIGGER IF EXISTS `%s`', $trigger));
        }

        out('  immutability triggers lifted for this operation', 'grey');

        foreach ($destroys as $table => $column) {
            $db->execute(
                sprintf('DELETE FROM `%s` WHERE `%s` = :id', $table, $column),
                ['id' => $userId]
            );
        }

        // Everything else either cascades or is set to NULL by the schema, so
        // the user row goes last and takes the rest with it.
        $db->execute('DELETE FROM users WHERE user_id = :id', ['id' => $userId]);

        ok(sprintf('user %d purged, %d referencing row(s) destroyed', $userId, $total));
    } finally {
        // Not conditional on success. A half-finished purge that leaves the
        // audit table writable is the one outcome worth ruling out entirely.
        restoreImmutabilityTriggers($db);
        out('  immutability triggers restored', 'grey');
    }

    out('');
}

/**
 * Put the three no-delete guards back exactly as migration 007 defines them.
 *
 * Kept beside the purge rather than re-running the migration: 007 is recorded
 * as applied, so `migrate` will not run it again, and an administrator who
 * needed this would have no way to get the protection back.
 */
function restoreImmutabilityTriggers(Database $db): void
{
    $db->execute('DROP TRIGGER IF EXISTS trg_audit_no_delete');
    $db->execute(
        "CREATE TRIGGER trg_audit_no_delete BEFORE DELETE ON audit_logs FOR EACH ROW
         BEGIN
           SIGNAL SQLSTATE '45000'
             SET MESSAGE_TEXT = 'Audit logs are immutable and cannot be deleted.';
         END"
    );

    $db->execute('DROP TRIGGER IF EXISTS trg_security_no_delete');
    $db->execute(
        "CREATE TRIGGER trg_security_no_delete BEFORE DELETE ON security_logs FOR EACH ROW
         BEGIN
           SIGNAL SQLSTATE '45000'
             SET MESSAGE_TEXT = 'Security logs are immutable and cannot be deleted.';
         END"
    );

    $db->execute('DROP TRIGGER IF EXISTS trg_login_history_no_delete');
    $db->execute(
        "CREATE TRIGGER trg_login_history_no_delete BEFORE DELETE ON login_history FOR EACH ROW
         BEGIN
           SIGNAL SQLSTATE '45000'
             SET MESSAGE_TEXT = 'Login history is permanent and cannot be deleted.';
         END"
    );
}

/**
 * Work through every condition a fingerprint has to satisfy to open a session,
 * and say which one is not met.
 *
 * "It does not start" has meant a different thing each time it has been said:
 * the terminal throttled, the print matching a template the server had
 * forgotten, no schedule covering the moment, the terminal bound to the wrong
 * room. Each looks identical from the outside — a finger on the sensor and
 * nothing happening — and each needed a different fix. The checks are all
 * cheap; what was missing was somewhere to read them together.
 *
 * Deliberately read-only. It opens nothing and changes nothing, so it is safe
 * to run against a system a class is waiting on.
 *
 * @param list<string> $arguments
 */
function commandSessionWhy(array $arguments): void
{
    $db       = Database::instance();
    $selector = $arguments[0] ?? '';

    $devices = $selector === ''
        ? $db->select('SELECT device_row_id FROM v_device_status ORDER BY device_id')
        : $db->select(
            'SELECT device_row_id FROM v_device_status WHERE device_id = :sel OR device_row_id = :num',
            ['sel' => $selector, 'num' => (int) $selector]
        );

    if ($devices === []) {
        fail($selector === ''
            ? 'No terminals are registered.'
            : sprintf('No terminal matches "%s". Pass a device id, or nothing to check them all.', $selector));
    }

    $now = Clock::now();

    heading('Right now');
    out(sprintf('  %-22s %s', 'Server time', $now->format('D d M Y H:i:s')), 'grey');
    out(sprintf('  %-22s %s', 'Day', $now->format('l')), 'grey');

    if (Clock::isShifted()) {
        out(sprintf('  %-22s %s (real time is %s)', 'Clock shift', 'ACTIVE', Clock::real()->format('D d M Y H:i:s')), 'yellow');
    }

    foreach ($devices as $row) {
        $device = $db->selectOne(
            'SELECT * FROM v_device_status WHERE device_row_id = :id',
            ['id' => (int) $row['device_row_id']]
        );

        if ($device === null) {
            continue;
        }

        heading(sprintf('%s — %s', (string) $device['device_id'], (string) $device['device_name']));

        $blockers = [];

        // --- the terminal itself ---
        if ((string) $device['claim_status'] !== 'claimed') {
            $blockers[] = 'The terminal has not claimed its key yet, so it cannot sign any request. '
                        . 'Flash it with its provisioning file and let it claim.';
        }

        if ((string) $device['configured_status'] !== 'active') {
            $blockers[] = sprintf('The terminal is set to "%s" rather than active.', $device['configured_status']);
        }

        $seen = $device['seconds_since_heartbeat'] === null
            ? 'never'
            : sprintf('%d s ago', (int) $device['seconds_since_heartbeat']);

        out(sprintf('  %-22s %s', 'Claim', $device['claim_status']), 'grey');
        out(sprintf('  %-22s %s (last heartbeat %s)', 'Health', $device['health'], $seen),
            (string) $device['health'] === 'online' ? 'grey' : 'yellow');

        if ((string) $device['health'] !== 'online') {
            // Not fatal on its own — a verify arriving from a terminal that has
            // been quiet still opens a session — but it is nearly always the
            // visible end of something else, so it is worth saying plainly.
            out('    A terminal that is not heartbeating is usually not reaching the server at all.', 'grey');
            out('    Check its serial output: a 429 there means it is being throttled.', 'grey');
        }

        // --- the classroom binding ---
        if ($device['classroom_id'] === null) {
            $blockers[] = 'The terminal is not bound to a classroom. Schedules are matched by room, '
                        . 'so an unbound terminal can never find one. Set the classroom on the device.';
            out(sprintf('  %-22s %s', 'Classroom', 'NOT SET'), 'red');
        } else {
            out(sprintf('  %-22s %s (%s)', 'Classroom', $device['room_number'], $device['building']), 'grey');
        }

        // --- schedules for this room today ---
        $today = $db->select(
            "SELECT sch.schedule_id, sch.day_of_week, sch.start_time, sch.end_time, sch.status,
                    sch.time_in_window_open, sch.time_out_window_close,
                    sub.subject_code, sec.section_code,
                    CONCAT(t.first_name, ' ', t.last_name) AS teacher_name,
                    t.teacher_id, t.fingerprint_status
               FROM schedules sch
               JOIN subjects sub ON sub.subject_id = sch.subject_id
               JOIN sections sec ON sec.section_id = sch.section_id
               JOIN teachers t   ON t.teacher_id = sch.teacher_id
              WHERE sch.classroom_id = :room
                AND sch.day_of_week = :day
                AND sch.deleted_at IS NULL
              ORDER BY sch.start_time",
            ['room' => $device['classroom_id'], 'day' => $now->format('l')]
        );

        out(sprintf('  %-22s %d for %s', 'Schedules in this room', count($today), $now->format('l')), 'grey');

        if ($today === [] && $device['classroom_id'] !== null) {
            $anyDay = (int) $db->scalar(
                'SELECT COUNT(*) FROM schedules WHERE classroom_id = :room AND deleted_at IS NULL',
                ['room' => $device['classroom_id']]
            );

            $blockers[] = $anyDay === 0
                ? 'No schedule exists for this room at all. Create one in Schedules.'
                : sprintf('This room has %d schedule(s), but none on a %s. A session can only open '
                        . 'inside a scheduled class.', $anyDay, $now->format('l'));
        }

        // ScheduleService is the same code the fingerprint path uses, so an
        // answer here is the answer the terminal will get.
        $active = App\Services\ScheduleService::activeForDevice((int) $device['device_row_id'], $now);
        $activeIds = array_map(static fn (array $s): int => (int) $s['schedule_id'], $active);

        foreach ($today as $schedule) {
            $isActive = in_array((int) $schedule['schedule_id'], $activeIds, true);

            $opens = $now->setTime(0, 0)->modify($schedule['start_time'])
                ->modify('-' . (int) $schedule['time_in_window_open'] . ' minutes');
            $shuts = $now->setTime(0, 0)->modify($schedule['end_time'])
                ->modify('+' . (int) $schedule['time_out_window_close'] . ' minutes');

            out(sprintf('    %s %s %s  %s-%s  window %s-%s  %s',
                $isActive ? '>' : ' ',
                str_pad((string) $schedule['subject_code'], 10),
                str_pad((string) $schedule['section_code'], 10),
                substr((string) $schedule['start_time'], 0, 5),
                substr((string) $schedule['end_time'], 0, 5),
                $opens->format('H:i'),
                $shuts->format('H:i'),
                $isActive ? 'OPEN NOW' : 'not now'
            ), $isActive ? 'green' : 'grey');

            out(sprintf('        teacher %s, fingerprint %s, schedule %s',
                $schedule['teacher_name'],
                $schedule['fingerprint_status'] === 'enrolled' ? 'enrolled' : strtoupper((string) $schedule['fingerprint_status']),
                $schedule['status']
            ), 'grey');

            if ($isActive) {
                if ((string) $schedule['status'] !== 'active') {
                    $blockers[] = sprintf('The class open right now (%s) is set to "%s", not active.',
                        $schedule['subject_code'], $schedule['status']);
                }

                $template = $db->selectOne(
                    'SELECT sensor_template_id, status FROM fingerprint_templates WHERE teacher_id = :t',
                    ['t' => (int) $schedule['teacher_id']]
                );

                if ($template === null) {
                    $blockers[] = sprintf('%s has no fingerprint enrolled, so nothing they scan can be '
                                        . 'recognised. Enrol them in Fingerprints.', $schedule['teacher_name']);
                } else {
                    out(sprintf('        sensor slot %d (%s)', (int) $template['sensor_template_id'], $template['status']), 'grey');

                    if ((string) $template['status'] !== 'active') {
                        $blockers[] = sprintf("%s's fingerprint is %s rather than active.",
                            $schedule['teacher_name'], $template['status']);
                    }
                }
            }
        }

        if ($active === [] && $today !== []) {
            $blockers[] = sprintf('A class is scheduled in this room today, but none covers %s. '
                                . 'Wait for the window, or use time:shift to test.', $now->format('H:i'));
        }

        // --- verdict ---
        if ($blockers === []) {
            ok('Nothing is blocking a session. The assigned teacher scanning now should open one.');
            out('  If it still refuses, the terminal\'s serial output carries the server\'s reason verbatim.', 'grey');
        } else {
            out('');
            out('  Blocking:', 'red');

            foreach ($blockers as $index => $blocker) {
                out(sprintf('    %d. %s', $index + 1, $blocker), 'yellow');
            }
        }
    }

    out('');
}

function commandSchemaDump(): void
{
    heading('Dumping schema and reference data');

    $config   = (array) Config::get('database', []);
    $database = (string) ($config['database'] ?? '');
    $target   = BASE_PATH . '/database/lsiams_schema.sql';

    // mysqldump is part of the MySQL/MariaDB client package. Without it there
    // is nothing to fall back on, so say what to install rather than failing
    // with a bare "command not found".
    $binary = null;

    foreach (['mysqldump', 'mariadb-dump'] as $candidate) {
        exec(sprintf('command -v %s 2>/dev/null', escapeshellarg($candidate)), $found, $status);

        if ($status === 0 && $found !== []) {
            $binary = $candidate;
            break;
        }
    }

    if ($binary === null) {
        fail('Neither mysqldump nor mariadb-dump is on PATH. Install the MySQL or MariaDB client tools.');
        return;
    }

    $header = <<<HEADER
    -- ===========================================================================
    -- L-SIAMS — complete schema and reference data
    --
    -- Import through phpMyAdmin (Import → choose file → Go) or from a shell:
    --   mysql -u root -p < lsiams_schema.sql
    --
    -- The file creates the `%s` database and selects it, so nothing needs to
    -- exist or be selected beforehand.
    --
    -- Contains every table, view, trigger, index and constraint, plus the
    -- reference data the system needs to start: roles, permissions, grade
    -- levels, departments, the attendance-status vocabulary, the default
    -- settings and the current school year.
    --
    -- Contains NO user accounts and no student, teacher or attendance data.
    -- Create the first administrator after importing:
    --   php bin/console user:create-admin
    --
    -- Generated by `php bin/console schema:dump` on %s.
    -- Do not hand-edit — schema changes belong in database/migrations/.
    -- ===========================================================================


    HEADER;

    // The password reaches mysqldump through the environment rather than the
    // command line, where `ps` would show it to every user on the machine.
    $command = sprintf(
        'MYSQL_PWD=%s %s --no-tablespaces --routines --triggers --events '
        . '--default-character-set=utf8mb4 --skip-add-locks --skip-comments '
        . '--complete-insert --single-transaction --host=%s --port=%d --user=%s %s 2>/dev/null',
        escapeshellarg((string) ($config['password'] ?? '')),
        $binary,
        escapeshellarg((string) ($config['host'] ?? '127.0.0.1')),
        (int) ($config['port'] ?? 3306),
        escapeshellarg((string) ($config['username'] ?? '')),
        escapeshellarg($database)
    );

    $body = shell_exec($command);

    if (!is_string($body) || trim($body) === '') {
        fail('mysqldump produced no output. Check the credentials in .env and that the database exists.');
        return;
    }

    // mysqldump stamps the account that produced the dump into every view,
    // trigger and routine. That account does not exist on the machine doing the
    // import, and the server refuses to run an object whose definer it cannot
    // resolve — the admin dashboard 500s on the first view it touches, which is
    // v_device_status. Dropping the clause makes the importing account the
    // definer, and SQL SECURITY INVOKER then evaluates views with the
    // privileges of whoever queries them, so the REVOKEs that
    // docs/DEPLOYMENT.md applies to lsiams_app still bite.
    $body = (string) preg_replace('/DEFINER=`(?:[^`]|``)*`@`(?:[^`]|``)*`\s?/', '', $body);
    $body = str_replace('SQL SECURITY DEFINER', 'SQL SECURITY INVOKER', $body);

    if (str_contains($body, 'DEFINER=')) {
        fail('Could not strip every DEFINER clause from the dump. Refusing to write a file that only imports on this machine.');
        return;
    }

    // Refuse to ship real people's data. A dump taken against a live or
    // demo-seeded database would otherwise be committed to the repository.
    $db = Database::instance();

    foreach (['users' => 'user accounts', 'students' => 'students', 'attendance_records' => 'attendance records'] as $table => $label) {
        $count = (int) $db->scalar("SELECT COUNT(*) FROM {$table}");

        if ($count > 0) {
            fail(sprintf(
                'Refusing to dump: the database holds %d %s. Run `migrate:fresh --force` then `seed` first, '
                . 'so the file carries reference data only.',
                $count,
                $label
            ));
            return;
        }
    }

    // Newer mariadb-dump opens its output with a client-side directive:
    //
    //     /*M!999999\- enable the sandbox mode */
    //
    // It is meaningful only to the `mariadb` command-line client, and the
    // version gate makes every server ignore it. phpMyAdmin's SQL parser does
    // not: the backslash inside the comment is enough to make some versions
    // abort the import on the first line, before a single table is created.
    // Nothing is lost by removing it.
    // The backslash is part of the payload, so it has to survive PHP's string
    // parsing and then be escaped again for the regex: '\\\\' is one literal
    // backslash by the time the pattern is compiled.
    $body = (string) preg_replace('~/\*M!\d+\\\\-[^*]*\*/\s*~', '', $body);

    // Foreign keys are switched off around the whole file because mysqldump
    // emits tables alphabetically, not in dependency order: api_key_history is
    // first and references devices, api_keys and users, all created hundreds of
    // lines later. mysqldump does say so itself — but only inside
    // /*!40014 ... */, a versioned comment, and anything that strips comments or
    // runs one statement at a time loses it and then fails with
    // "errno: 150 - Foreign key constraint is incorrectly formed" on the very
    // first table. Saying it in plain SQL costs nothing and survives.
    $quoted   = '`' . str_replace('`', '``', $database) . '`';
    $preamble = sprintf(
        "CREATE DATABASE IF NOT EXISTS %s CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;\n"
        . "USE %s;\n\n"
        . "-- Tables are emitted alphabetically rather than in dependency order,\n"
        . "-- so the constraints are only valid once every table exists.\n"
        . "SET FOREIGN_KEY_CHECKS = 0;\n\n",
        $quoted,
        $quoted
    );

    $postamble = "\n-- Re-enabled once every table, view and trigger exists.\n"
               . "SET FOREIGN_KEY_CHECKS = 1;\n";

    file_put_contents(
        $target,
        sprintf($header, $database, date('Y-m-d')) . $preamble . $body . $postamble
    );

    ok(sprintf("database/lsiams_schema.sql written (%.1f KB)", filesize($target) / 1024));
    out(sprintf('  %d tables, %d triggers, %d insert statements',
        substr_count($body, 'CREATE TABLE'),
        substr_count($body, 'TRIGGER'),
        substr_count($body, 'INSERT INTO')
    ), 'grey');
}
