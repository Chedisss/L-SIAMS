# ---------------------------------------------------------------------------
# L-SIAMS environment configuration
# Copy to .env and adjust. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

APP_NAME="L-SIAMS"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://192.168.1.10
APP_TIMEZONE=Asia/Manila

# Shifts every clock the application reads, so a schedule can be tested
# without waiting for its window. Two styles, and they behave differently:
#
#   +2 hours, -45 minutes    the clock RUNS, just offset. Use this to watch a
#                            tap-in window open, go late, and close.
#   "next monday 08:05"      the clock is PINNED to that instant and does not
#                            advance. Use this for a single check.
#
# Leave empty in normal use. Ignored entirely when APP_ENV=production, because
# an attendance system on a shifted clock writes records at times that never
# happened. Set it with:  console.bat time:shift "+2 hours"
APP_CLOCK_OFFSET=

# --- Database --------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lsiams_db
DB_USER=lsiams_app
DB_PASS=change-me
DB_CHARSET=utf8mb4

# --- Cryptography ----------------------------------------------------------
# Generate with:  php bin/console key:generate
# APP_KEY encrypts HMAC secrets at rest (AES-256-GCM). 32 raw bytes, base64.
APP_KEY=
# API_KEY_PEPPER is mixed into API-key hashes. 32 raw bytes, base64.
API_KEY_PEPPER=
# REALTIME_TICKET_SECRET signs short-lived WebSocket tickets.
REALTIME_TICKET_SECRET=

# --- Session ---------------------------------------------------------------
SESSION_IDLE_TIMEOUT_MINUTES=10
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
SESSION_COOKIE_NAME=lsiams_session
SESSION_COOKIE_SECURE=true

# --- Realtime --------------------------------------------------------------
REALTIME_WS_HOST=0.0.0.0
REALTIME_WS_PORT=8443
REALTIME_WS_PUBLIC_URL=wss://192.168.1.10:8443
REALTIME_TLS_CERT=/etc/ssl/lsiams/server.crt
REALTIME_TLS_KEY=/etc/ssl/lsiams/server.key
# Leave both of these alone on a deployment. They exist so a local development
# machine can run without a certificate; turning TLS off in a school would put
# attendance events on the network in the clear, and turning SSE off only makes
# sense on PHP's single-threaded built-in server.
REALTIME_TLS_ENABLED=true
REALTIME_SSE_ENABLED=true

# --- Network ---------------------------------------------------------------
# Comma separated CIDR ranges permitted to reach the web UI and the device API.
TRUSTED_WEB_CIDRS=192.168.1.0/24
TRUSTED_DEVICE_CIDRS=192.168.1.0/24
TRUST_PROXY=false

# Requests one terminal may make per minute. 0 means no limit, which is the
# right setting while a board is on the bench: a throttled heartbeat, poll or
# fingerprint verify looks exactly like the hardware fault you are trying to
# diagnose.
#
# 240 requests a minute per terminal. They run unattended, where one stuck in a
# retry loop should not be able to saturate the server — and 240 is comfortably
# above the ~110 requests a minute a busy class produces.
#
# Set it to 0 to switch the limit off while diagnosing a terminal, and put it
# back afterwards.
#
# Signature, device id and allowlist checks apply either way; this only caps how
# often an already-authenticated terminal may speak.
DEVICE_RATE_LIMIT=240

# --- Which terminals hold which fingerprints -------------------------------
#
# A sensor can only match templates in its own flash, so a teacher's template is
# copied to the terminals that may need it. This decides which ones those are.
#
#   all        every classroom terminal holds every enrolled teacher, so any
#              teacher can start a class at any reader — a substitute, or a room
#              changed at an hour's notice, is recognised without the timetable
#              being edited first.
#
#   timetable  a terminal holds only the teachers scheduled into its own room.
#              A board unscrewed from a corridor wall then carries those few
#              templates instead of the whole staff. The cost is that a teacher
#              with no schedule in a room is not known to its reader, and their
#              class cannot start there until the timetable says so.
#
# Neither setting decides who may open a class — that is the schedule and a live
# signed request, checked on the server every time. What changes is how much
# biometric data sits in each sensor.
FINGERPRINT_SYNC_SCOPE=all
