/vendor/
/.env
/storage/logs/*.log
/storage/cache/*
/storage/reports/*
/storage/tmp/*
/storage/framework/sessions/*
/database/backups/*.sql
/database/backups/*.gz
/database/backups/*.enc
/public/uploads/students/*
/public/uploads/teachers/*
!.gitkeep
.DS_Store
*.swp
node_modules/

# Terminal credentials. The sketch is tracked and update.bat replaces every
# tracked file, so both of these have to be invisible to git or the update
# would eat them: the optional secrets.h, and the copy update.bat saves of a
# sketch you had edited.
/firmware/*/secrets.h
/firmware/*/*.ino.your-copy
