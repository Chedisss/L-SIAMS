/* ===========================================================================
 * L-SIAMS terminal — credentials
 * ---------------------------------------------------------------------------
 * Copy this file to  secrets.h  in the same folder, then fill it in.
 *
 *      copy secrets.h.example secrets.h        (Windows)
 *      cp   secrets.h.example secrets.h        (Mac / Linux)
 *
 * secrets.h is gitignored, so update.bat will not overwrite it. The sketch
 * itself IS tracked — anything you type into the .ino is replaced by the
 * official version on the next update, and reverts to placeholders without
 * saying so.
 *
 * Four of the seven values come from the provisioning JSON downloaded when you
 * registered the terminal in Devices → Register terminal. That download is the
 * only copy of the API key and HMAC secret that will ever exist, and every
 * fresh download rotates them — so use one file, and do not download again
 * after flashing.
 *
 * Do not commit secrets.h. If one is committed by accident, revoke that
 * device's API key from the web interface and register the terminal again;
 * rewriting history is not enough, because the key was published the moment
 * the commit was pushed.
 * =========================================================================== */

#pragma once

/* --- your network ------------------------------------------------------- */

#define LS_WIFI_SSID    "YOUR_WIFI_NAME"
#define LS_WIFI_PASS    "YOUR_WIFI_PASSWORD"

/* The host PC's LAN address, WITH the port.
 *
 * Never localhost or 127.0.0.1 — to the ESP32 those mean the ESP32 itself, so
 * the request never leaves the board. Find the PC's address with:
 *
 *   (Get-NetIPConfiguration | Where-Object {$_.IPv4DefaultGateway -ne $null}).IPv4Address.IPAddress
 *
 * The terminal compares its own IP against this after joining and warns if
 * they are on different subnets, which is the commonest reason a terminal
 * joins the Wi-Fi, reports nothing, and shows as Offline with no error. */
#define LS_SERVER_URL   "http://192.168.0.100:8080"

/* --- from the provisioning JSON ----------------------------------------- */

#define LS_DEVICE_ID    "DEV-2026-0001"
#define LS_API_KEY      "lsk_xxxxxxxx.yyyyyyyy"
#define LS_HMAC_SECRET  "zzzzzzzzzzzzzzzz"

/* Single use. The first boot presents it, the server consumes it, and the
 * device is claimed for good. Blank it afterwards — leaving it set does no
 * harm, but a token that cannot work again is one more thing to wonder about
 * when something else breaks. */
#define LS_CLAIM_TOKEN  ""
