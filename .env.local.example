# ---------------------------------------------------------------------------
# L-SIAMS — local development settings (XAMPP on Windows)
#
# start.bat copies this to .env on first run and generates the keys. It is the
# convenience configuration for running the system on one machine to try it or
# develop against it.
#
# DO NOT DEPLOY WITH THIS FILE. It turns off three protections that only make
# sense to relax on localhost, each marked below. Use .env.example as the base
# for anything a student or a teacher will actually use.
# ---------------------------------------------------------------------------

APP_NAME="L-SIAMS"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Manila

# --- Database --------------------------------------------------------------
# XAMPP's MySQL/MariaDB defaults: user root, no password. Create the database
# first in phpMyAdmin, or let start.bat create it for you.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lsiams_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- Cryptography ----------------------------------------------------------
# Left blank on purpose: start.bat runs `php bin/console key:generate`, which
# fills these with 256-bit CSPRNG values. Never copy keys between machines.
APP_KEY=
API_KEY_PEPPER=
REALTIME_TICKET_SECRET=

# --- Session ---------------------------------------------------------------
SESSION_IDLE_TIMEOUT_MINUTES=10
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
SESSION_COOKIE_NAME=lsiams_session

# RELAXED #1 — a Secure cookie is never sent over http://, so leaving this on
# would make login silently fail on localhost. The application also drops the
# __Host- cookie prefix when Secure is off, because that prefix requires it.
# Set this back to true the moment the system is served over HTTPS.
SESSION_COOKIE_SECURE=false

# --- Realtime --------------------------------------------------------------
# 0.0.0.0 so other devices on the same Wi-Fi can reach the live updates. On
# 127.0.0.1 the realtime server would accept connections only from the machine
# it runs on, and every other device would sit on "Connecting" forever.
REALTIME_WS_HOST=0.0.0.0
REALTIME_WS_PORT=8443

# Deliberately blank. Left empty, the application builds the WebSocket URL from
# whatever address the browser used — localhost on this machine, 192.168.x.x on
# a phone or another laptop — so one setting works for every device on the LAN.
# Fill it in only behind a reverse proxy, where the public name differs from
# what this process sees.
REALTIME_WS_PUBLIC_URL=

# RELAXED #2 — no certificate exists on a fresh machine, so the realtime server
# could not start at all with TLS on. On a deployment this must be true: an
# unencrypted WebSocket carries attendance events across the school network in
# the clear.
REALTIME_TLS_ENABLED=false
REALTIME_TLS_CERT=
REALTIME_TLS_KEY=

# RELAXED #3 — not a security setting. PHP's built-in development server is
# single threaded on Windows, and one open Server-Sent Events stream would
# block every other request until it timed out, freezing the whole application.
# With SSE off the browser uses the WebSocket, or falls back to short polling,
# which returns immediately and does not block. Leave this at its default
# (true) under Apache or PHP-FPM, where holding a connection is fine.
REALTIME_SSE_ENABLED=false

# --- Network ---------------------------------------------------------------
# Loopback plus the usual private ranges, so a phone or a terminal on the same
# Wi-Fi can reach the machine while it is being demonstrated.
TRUSTED_WEB_CIDRS=127.0.0.0/8,192.168.0.0/16,10.0.0.0/8
TRUSTED_DEVICE_CIDRS=127.0.0.0/8,192.168.0.0/16,10.0.0.0/8
TRUST_PROXY=false
